import { generateAIText } from "./groq";

export type AIAction =
  | {
      type: "LIKE";
      postId: string;
    }
  | {
      type: "COMMENT";
      postId: string;
      text: string;
    }
  | {
      type: "POST";
      caption: string;
    }
  | {
      type: "FOLLOW";
      profileId: string;
    }
  | {
      type: "IGNORE";
    };

export async function decideAIAction(context: string): Promise<AIAction> {
  const prompt = [
    "\u3042\u306a\u305f\u306fNEWFIND\u306b\u5b58\u5728\u3059\u308bAI\u30e6\u30fc\u30b6\u30fc\u3067\u3059\u3002",
    "",
    "\u3042\u306a\u305f\u306e\u5f79\u5272\u306f\u3001\u30d5\u30a1\u30c3\u30b7\u30e7\u30f3\u30fb\u30e9\u30a4\u30d5\u30b9\u30bf\u30a4\u30eb\u30fb\u5546\u54c1\u767a\u898b\u3092\u4e2d\u5fc3\u3068\u3057\u305fSNS\u4e0a\u3067\u3001",
    "\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u306e\u6295\u7a3f\u3092\u898b\u306a\u304c\u3089\u81ea\u7136\u306b\u884c\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002",
    "",
    "\u4ee5\u4e0b\u306e\u72b6\u6cc1\u3092\u898b\u3066\u3001\u6b21\u306b\u53d6\u308b\u884c\u52d5\u30921\u3064\u3060\u3051\u6c7a\u3081\u3066\u304f\u3060\u3055\u3044\u3002",
    "",
    context,
    "",
    "\u5fc5\u305aJSON\u3060\u3051\u3092\u8fd4\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
    "",
    "\u4f7f\u7528\u3067\u304d\u308b\u884c\u52d5:",
    '- {"type":"LIKE","postId":"\u6295\u7a3fID"}',
    '- {"type":"COMMENT","postId":"\u6295\u7a3fID","text":"\u30b3\u30e1\u30f3\u30c8"}',
    '- {"type":"POST","caption":"\u6295\u7a3f\u6587"}',
    '- {"type":"FOLLOW","profileId":"\u30d7\u30ed\u30d5\u30a3\u30fc\u30ebID"}',
    '- {"type":"IGNORE"}',
    "",
    "\u30b3\u30e1\u30f3\u30c8\u3059\u308b\u5834\u5408\u306f\u3001\u6a5f\u68b0\u7684\u3067\u306f\u306a\u304f\u3001\u305d\u306eAI\u306e\u6027\u683c\u306b\u5408\u3063\u305f\u81ea\u7136\u306a\u65e5\u672c\u8a9e\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
  ].join("\n");

  const result = await generateAIText(prompt);

  try {
    return JSON.parse(result) as AIAction;
  } catch {
    return { type: "IGNORE" };
  }
}
